# AFIT Market - environment template. PLACEHOLDERS ONLY. Never commit real values.
# Copy to .env.local and fill with LOCAL values printed by `pnpm exec supabase status -o env`.
# No variable here uses the NEXT_PUBLIC_ prefix on purpose: the browser never talks to Supabase
# directly in this app (all auth/data calls happen on the server), so nothing secret or
# Supabase-related is ever bundled for the client.

# Public site origin used for auth redirects (local dev default shown)
SITE_URL=http://127.0.0.1:3000

# Supabase API URL (server-side use only)
SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable (anon-equivalent) key - server-side use
SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key
# Supabase service-role / secret key - SERVER ONLY. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key
# Direct Postgres URL used only by database tests (local stack only)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# Local mail sink (scripts/mail-sink.mjs) used by e2e tests to read confirmation emails
MAIL_SINK_URL=http://127.0.0.1:54326

# Deployment environment. `local` enables the MOCK payment button (together with the database flag
# mock_payments_enabled). Anything else - or leaving it unset - means production behavior (fail closed).
APP_ENV=local

# Paystack TEST mode only (sk_test_...). Live keys are rejected by the app. Leave unset to disable online payment.
# Locally the fake provider (scripts/fake-paystack.mjs) is used: PAYSTACK_BASE_URL is honoured only when APP_ENV=local.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_test_key
# PAYSTACK_BASE_URL=http://127.0.0.1:3002

# Shared secret for the scheduled job route /api/jobs/expire-orders (send as `Authorization: Bearer <value>`)
JOBS_SECRET=replace-with-a-long-random-value

# Server-only secret used to derive customer pickup codes (HMAC). 32+ random characters. NEVER commit a real value,
# never prefix with NEXT_PUBLIC_, never store in the database. Missing/short/placeholder values make pickup codes unavailable.
PICKUP_CODE_SECRET=replace-with-32-plus-random-characters
